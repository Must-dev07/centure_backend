# ============================================================================
# Smart belt backend — environment template. Copy to .env and fill.
# No secrets are committed; REQUIRES: lines mark credential injection points.
# ============================================================================

# --- Django core -------------------------------------------------------------
# REQUIRES: DJANGO_SECRET_KEY  (generate: python -c "import secrets;print(secrets.token_urlsafe(64))")
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (docker-compose sets POSTGRES_HOST=db automatically) -----------
POSTGRES_DB=belt
POSTGRES_USER=belt
# REQUIRES: POSTGRES_PASSWORD
POSTGRES_PASSWORD=
# POSTGRES_HOST / POSTGRES_PORT are injected by docker-compose; set manually
# only when running outside compose. Leaving POSTGRES_HOST empty makes Django
# fall back to SQLite (local dev/tests only).
#POSTGRES_HOST=
#POSTGRES_PORT=5432

# --- Redis / Celery -----------------------------------------------------------
# Injected by docker-compose as redis://redis:6379/0; override for external Redis.
#REDIS_URL=
NO_DATA_CHECK_SECONDS=60

# --- JWT ----------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- CORS (dashboard origin) ---------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3100

# --- Firebase Cloud Messaging (push notifications) ----------------------------
# REQUIRES: FCM_PROJECT_ID  (Firebase console → project settings)
FCM_PROJECT_ID=
# REQUIRES: FCM_SERVICE_ACCOUNT_FILE  (path to the service-account JSON mounted
# into the containers, e.g. /app/secrets/firebase-sa.json)
FCM_SERVICE_ACCOUNT_FILE=

# --- Alert thresholds (older child; defaults live in config/settings.py
# ANALYSIS_THRESHOLDS — uncomment only to override) ---------------------------
# HR_REST_HIGH_BPM=100
# HR_EFFORT_HIGH_BPM=160
# HR_CRITICAL_HIGH_BPM=180
# HR_WARN_LOW_BPM=50
# HR_CRITICAL_LOW_BPM=40
# RESP_REST_HIGH_BRPM=30
# RESP_EFFORT_HIGH_BRPM=40
# RESP_CRITICAL_HIGH_BRPM=50
# RESP_WARN_LOW_BRPM=12
# RESP_CRITICAL_LOW_BRPM=8
# TEMP_INFO_HIGH_C=37.5
# TEMP_FEVER_C=38.0
# TEMP_CRITICAL_HIGH_C=39.0
# TEMP_WARN_LOW_C=36.0
# TEMP_CRITICAL_LOW_C=35.0
# BATTERY_INFO_PCT=20
# BATTERY_WARN_PCT=10
# PERSIST_READINGS=3
# PERSIST_CRITICAL_READINGS=6
# PERSIST_WINDOW_S=300
NO_DATA_MINUTES=5.0

# --- Throttling ----------------------------------------------------------------
THROTTLE_AUTH=20/min
THROTTLE_INGEST=600/min
THROTTLE_USER=1000/hour

# --- nginx ----------------------------------------------------------------------
NGINX_PORT=8080
